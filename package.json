{
  "name": "env-vault",
  "private": true,
  "version": "1.0.0",
  "description": "Store, edit and export your .env files in an encrypted vault, independent of project folders.",
  "author": {
    "name": "Vellium",
    "url": "https://vellium.dev"
  },
  "homepage": "https://vellium.dev",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:version": "node scripts/check-version-consistency.js",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "check:i18n:usage": "node scripts/check-i18n-usage.mjs",
    "check:typography": "node scripts/check-typography.mjs",
    "verify": "npm run check:version && npm run check:i18n && npm run check:i18n:usage && npm run check:typography && npm run typecheck && npm test",
    "tauri": "tauri",
    "build:app": "npm run build && npx @tauri-apps/cli build",
    "build:portable": "npm run build && npx @tauri-apps/cli build --no-bundle"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/language": "^6.10.8",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.4",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "codemirror": "^6.0.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
