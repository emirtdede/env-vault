{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Env Vault",
  "version": "1.0.0",
  "identifier": "com.vellium.envvault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Env Vault",
        "url": "index.html",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {}
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "DeveloperTool",
    "publisher": "Vellium",
    "copyright": "Copyright 2026 Vellium. All rights reserved.",
    "shortDescription": "Store, edit and export your .env files in an encrypted vault, independent of project folders.",
    "longDescription": "Env Vault is a Windows desktop application that lets developers keep .env files out of project folders in a local, encrypted vault. Import environment files by drag and drop or with the Add button, edit and organize them, and export them back to .env files whenever needed. The encrypted copy stays safe even if the source project or .env file is later deleted. Env Vault needs no internet connection for its core features and never sends your secrets to a remote service.",
    "icon": [
      "icons/16x16.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installMode": "currentUser",
        "languages": [
          "English",
          "Turkish",
          "German",
          "Spanish",
          "French",
          "Italian",
          "Portuguese",
          "PortugueseBR",
          "Dutch",
          "Polish",
          "Russian",
          "Japanese",
          "Korean",
          "SimpChinese",
          "TradChinese",
          "Swedish",
          "Arabic",
          "Hindi",
          "Indonesian",
          "Vietnamese",
          "Ukrainian",
          "Greek",
          "Czech",
          "Danish",
          "Finnish",
          "Norwegian",
          "Hungarian",
          "Romanian",
          "Thai",
          "Malay",
          "Hebrew",
          "Farsi",
          "Azerbaijani",
          "Uzbek",
          "Bulgarian",
          "Slovak",
          "Croatian",
          "Estonian",
          "Lithuanian",
          "Latvian",
          "Serbian",
          "SerbianLatin",
          "Slovenian",
          "Bosnian",
          "Albanian",
          "Macedonian",
          "Icelandic",
          "Afrikaans",
          "Georgian",
          "Armenian",
          "Mongolian",
          "Catalan",
          "Basque",
          "Galician",
          "Irish"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "installer-hooks.nsh"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
